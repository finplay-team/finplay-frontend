# 필요한 환경변수 목록. 실제 값은 .env.production 등으로 복사해 채운다 (.gitignore가 .env.*를 막는다).

# API 서버 베이스 URL. 비워 두면(로컬 dev 기본) 상대경로 '/api'를 그대로 쓰고
# vite.config.ts의 dev 프록시(http://localhost:8080)가 동일 오리진으로 만들어 준다.
#
# 프론트를 S3로 배포할 때만 채운다 (finplay-api ADR-0022) — 끝에 슬래시를 붙이지 않는다.
#   예: VITE_API_BASE_URL=https://finplay.site
VITE_API_BASE_URL=
